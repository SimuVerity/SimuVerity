{
  "id": "D008",
  "schema_version": "1.0",
  "scoring": "layered-continuous",
  "domain": "facts",
  "title": "D008: Three-phase STATCOM -> regulated DC-link + bipolar compensation current",
  "routing": "behavior+structure+scenarios",
  "prompt": "Build a three-phase shunt STATCOM for a 50 Hz system. A three-phase grid and load must share a common PCC, and a controllable two-level voltage-source converter with a physical DC-link capacitor must connect in shunt at that PCC through one coupling reactor per phase. Read Vsrc_LL, P_load and Q_load from base-workspace variables; their nominal values are 190.53 V, 1000 W and 5000 var, and each operates over a +/-10% envelope. The measured DC-link voltage must remain near 399 V as these inputs vary, and the physical converter current must compensate the reactive component of the load current and respond in the appropriate direction when Q_load changes. The DC-link regulation and reactive compensation must establish promptly after startup. Log Timeseries Vdc, Vpcc, Icomp, Igrid and Iload. Vpcc must be one physically measured PCC phase voltage; Icomp, Igrid and Iload must each contain exactly the three physically measured phase currents. Define positive current from grid to PCC for Igrid, from PCC to load for Iload, and from PCC to converter for Icomp, so Igrid - Iload - Icomp must remain approximately zero at the PCC.",
  "sim": {
    "solver": [],
    "stop": 0.5,
    "max_step": []
  },
  "input_contract": {
    "Vsrc_LL": {
      "default": 190.5255888325765,
      "required": true,
      "required_block_any": [
        "source|grid"
      ],
      "required_parameter_any": [
        "voltage|amplitude|vrms"
      ],
      "min_bindings": 1
    },
    "P_load": {
      "default": 1000,
      "required": true,
      "required_block_any": [
        "load|rlc"
      ],
      "required_parameter_any": [
        "activepower|resistance|value"
      ],
      "min_bindings": 1
    },
    "Q_load": {
      "default": 5000,
      "required": true,
      "required_block_any": [
        "load|rlc"
      ],
      "required_parameter_any": [
        "inductivepower|reactivepower"
      ],
      "min_bindings": 1
    }
  },
