  "evaluation_policy_id": "simuverity-101-v1:d014:scoring",
  "policy_status": "CURRENT",
  "schema_version": "1.0",
  "scoring": "layered-continuous",
  "domain": "inverter",
  "title": "D014: Single-phase to three-phase converter (rectifier + inverter) -> DC bus + 3-phase AC",
  "routing": "behavior+structure+scenarios",
  "prompt": "Build a single-phase-input to three-phase-output power converter using Simscape Specialized Power Systems. A single-phase AC source must feed a rectifier, a smoothing DC link, and then a controllable three-phase inverter supplying a balanced load. Read Vsrc_amp and P_load from base-workspace variables. Vsrc_amp is the single-phase source peak amplitude, nominally 650 V. P_load is the balanced load's nominal active-power rating, nominally 2000 W. Both variables must operate over a +/-10% range around their nominal values. The inverter's three output phase voltages must be regulated in closed loop to produce balanced 50 Hz phase voltages with an RMS value of 222 V. Log Vdc, Vabc and Iabc as Timeseries. Vabc and Iabc must each contain all three physical phase voltages and currents measured at the inverter output.",
  "sim": {
    "solver": [],
    "stop": 0.5,
    "max_step": []
  },
  "input_contract": {
    "Vsrc_amp": {
      "default": 650,
      "required": true,
      "required_block_any": [
        "1-ph|single.phase|source|voltage"
      ],
      "required_parameter_any": [
        "amplitude|voltage|vrms"
      ],
      "min_bindings": 1
    },
    "P_load": {
