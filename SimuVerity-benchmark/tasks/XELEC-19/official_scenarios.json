  "contract": {
    "schema_version": "1.0",
    "scoring": "layered-continuous",
    "domain": "inverter",
    "title": "D019: Multilevel inverter (MLI, discrete-switch build) -> multilevel bipolar AC",
    "routing": "behavior+structure+scenarios",
    "prompt": "Build a three-phase multilevel inverter with an explicit power stage made from discrete controllable semiconductor switches rather than a preassembled bridge block. A DC source must feed the multilevel switching stage, which must supply a balanced three-phase load. Read P_load from a base-workspace variable; its nominal value is 500 W and its operating envelope is +/-10%. At nominal conditions one physically measured output phase must be a stepped bipolar 50 Hz waveform near 412 V peak-to-peak, and it must remain at the intended frequency and voltage level across the stated load envelope. Log that physical output phase voltage as a Timeseries named Vout.",
    "sim": {
      "solver": [],
      "stop": 0.5,
      "max_step": []
    },
    "input_contract": {
      "P_load": {
        "default": 500,
        "required": true,
        "required_block_any": [
          "load|rlc|resist|100 w"
        ],
        "required_parameter_any": [
          "activepower|resistance|value"
        ],
        "min_bindings": 1
      }
    },
    "outputs": [
      {
        "name": "Vout",
        "role": "core",
        "datatype": "timeseries",
        "min_channels": 1,
        "max_channels": 1,
        "time_coverage": 0.95,
        "min_samples": 16,
        "provenance": {
          "required_any_upstream": [
            "voltage measurement",
            "three-phase vi measurement"
          ],
          "forbidden_upstream": [
            "constant",
            "sine wave",
            "signal builder"
          ],
          "max_trace_depth": 24
        }
      }
    ],
    "behavioral": [
      {
        "id": "vout_pp",
        "signal": "Vout",
        "metric": "pp",
        "scenario": "nominal",
        "group": "nominal",
        "criticality": "must",
