{
  "id": "D022",
  "schema_version": "1.0",
  "scoring": "layered-continuous",
  "domain": "rectifier",
  "title": "D022: Universal electronic load controller (ELC) for micro-hydro -> regulated DC bus + AC",
  "routing": "behavior+structure+scenarios",
  "prompt": "Build an electronic load controller for a three-phase 50 Hz micro-hydro generator. The generator must feed a common PCC with separate user-load and converter-controlled ballast-load branches connected in parallel. Read R_user from a base-workspace variable; its nominal value is 10 ohm and its operating range is +/-10%. Regulate ballast absorption in closed loop so generator active power remains approximately constant as user load changes. The converter DC-bus target is about 1 kV and the generator-speed target is 1 pu. The regulated states and generator active power must settle promptly across the stated load range. PCC voltage and current must remain balanced and reasonably sinusoidal. Psource is positive from generator into PCC, Pload from PCC into user load, and Pdump from ballast branch toward PCC. Log physical Timeseries Vdc, Vabc, Iabc, Psource, Pload, Pdump and Speed. Vabc and Iabc must contain all three measured PCC phases; the power signals must measure their respective branches; Speed must be physical generator speed.",
  "sim": {
    "solver": [],
    "stop": 3.0,
    "max_step": []
  },
  "steady_state_policy": {
    "require_steady": true,
    "steady_stat": "rms",
    "steady_fraction": 0.2,
    "steady_cycle_hz": 50,
    "steady_cycles": 5,
    "steady_rel_range_max": 0.1,
    "steady_rel_drift_max": 0.1,
    "steady_all_channels": true
  },
  "input_contract": {
