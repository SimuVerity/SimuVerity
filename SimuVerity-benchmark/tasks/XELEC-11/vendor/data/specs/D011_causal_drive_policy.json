  "scoring": "layered-continuous",
  "domain": "motor_drive",
  "title": "D011: Single-phase-input frequency-controlled PMSM drive",
  "routing": "behavior+structure+scenarios",
  "prompt": "Build a single-phase-input permanent-magnet synchronous motor drive. A single-phase AC source must feed a rectifier and smoothing DC link, which must feed a controllable three-phase inverter supplying a Permanent Magnet Synchronous Machine. Read F_cmd from a base-workspace variable; its nominal value is 50 Hz and its operating range is 45 to 55 Hz. The physically measured inverter output frequency must follow F_cmd, and the physical rotor speed must change in the same direction as the commanded frequency while the three motor-side phases remain balanced. Log Timeseries Wm, Vdc, Vabc and Iabc. Wm must be the physical rotor mechanical speed, Vdc must be the measured DC-link voltage, and Vabc and Iabc must each contain exactly the three physically measured motor-side phases.",
  "sim": {
    "solver": [],
    "stop": 1,
    "max_step": []
  },
  "input_contract": {
    "F_cmd": {
      "default": 50,
      "required": true,
      "required_block_any": [
        "frequency|freq|(^|/)f$|constant"
      ],
      "required_parameter_any": [
        "value|frequency"
      ],
      "min_bindings": 1
    }
  },
