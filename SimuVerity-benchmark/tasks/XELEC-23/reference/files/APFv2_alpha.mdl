        <P Name="script">function [P,Q,Valpha,Vbeta] = PQ(x1,x2,y1,y2)
%#em1

P = (x1*y1)+(x2*y2);
Q = (x2*y1)-(x1*y2);
Valpha = x1;
Vbeta = x2;

