<chart id="17">
  <P Name="name">Shunt APF/PQ &amp; I-compensation Calc/Compensation current</P>
  <P Name="windowPosition">[341 332 213 385]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 1280 800 1.333333333333333]</P>
  <P Name="viewObj">17</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Ical</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">17</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [ICa,ICb,ICc] = Ical(Ic1,Ic2,Ic3)
%#em1

ICa = sqrt(2/3)*(Ic1+(0.7072*Ic3));
ICb = sqrt(2/3)*((-0.5*Ic1)+((sqrt(3)/2)*Ic2)+(0.7072*Ic3));
ICc = sqrt(2/3)*((-0.5*Ic1)-((sqrt(3)/2)*Ic2)+(0.7072*Ic3));


</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[3.0, 113.0, 576.0, 461.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="Ic1">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
