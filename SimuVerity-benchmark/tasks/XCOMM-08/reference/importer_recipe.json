{
  "schema": "simuverity.matlab-local-importer-recipe.v1",
  "task_id": "XCOMM-08",
  "release": "simuverity-101-v1",
  "matlab_release": "R2025a",
  "publisher": "The MathWorks, Inc.",
  "redistributes_mathworks_files": false,
  "destination": "%LOCALAPPDATA%/SimuVerity/assets/simuverity-101-v1/XCOMM-08",
  "discovery": {
    "method": "matlab_example_or_installed_product_search",
    "example_id": "comm/DigitalVideoBroadcastingTerrestrialExample",
    "expected_source_filenames": [
      "commdvbt.slx",
      "commdvbt_tablegen.m"
    ],
    "expected_files": [
      {
        "name": "commdvbt.slx",
        "size_bytes": 67554
      },
      {
        "name": "commdvbt_tablegen.m",
        "size_bytes": 4356
      }
    ]
  },
  "transform": "transform.m",
  "validation": {
    "required": true,
    "checks": [
      "load",
      "update",
      "compile",
      "simulate",
      "all_official_scenarios",
      "reference_score"
    ],
    "on_mismatch": "fail_closed"
  },
  "entrypoint": "commdvbt.slx",
  "expected_valid_scenarios": 6,
  "score_tolerance": 1e-12,
  "expected_score": 100.0,
  "scenario_contract": {
    "expected_ids": [
      "nominal",
      "lower_snr",
      "transition_snr",
      "high_snr",
      "alternate_seed_nominal",
      "alternate_seed_boundary"
    ],
    "nominal_scenario_id": "nominal",
    "nominal_materialization": "authoritative_scenario_set"
  },
  "score_tolerance_basis": "source_authority_numeric_precision"
}
