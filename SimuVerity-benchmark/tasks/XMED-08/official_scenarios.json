  "contract": {
    "simulation": {
      "source_sample_rate_hz": 360,
      "detector_sample_rate_hz": 200,
      "clean_truth_method": "paired run of the unchanged clean fixture through the same current detector; clean accepted events are retained before artifact injection",
      "event_matching_tolerance_seconds": 0.15,
      "retain_complete_run": true
    },
    "score_policy": {
      "admission_threshold_raw": 85,
      "preferred_reference_score": 90,
      "normalize_threshold_to_100": false,
      "qualification_gate": "G",
      "groups": {
        "A": {
          "weight": 0.2,
          "meaning": "nominal event detection, event timing and heart-rate accuracy"
        },
        "Q": {
          "weight": 0.1,
          "meaning": "complete evidence, valid denominators and internally consistent event/heart-rate outputs"
        },
        "M": {
          "weight": 0.3,
          "meaning": "causal multirate conditioning, adaptive thresholding and event-derived heart-rate mechanism"
        },
        "R": {
          "weight": 0.2,
          "meaning": "worst required heart-rate or artifact condition"
        },
        "D": {
          "weight": 0.2,
          "meaning": "threshold adaptation, transient recovery and response across physiology and artifact changes"
        }
      },
      "within_group": "weighted_arithmetic_mean",
      "across_groups": "weighted_geometric_mean",
      "critical_multiscenario_aggregation": "100_percent_minimum"
    },
    "minimum_shortcut_sanity_contract": [
      "missing_conditioning_or_detector_path",
      "constant_heart_rate_without_event_support",
      "replayed_event_schedule_across_distinct_rates",
      "fixed_threshold_peak_picker",
