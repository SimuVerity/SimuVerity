  "contract": {
    "simulation": {
      "start_s": 0,
      "simulation_mode": "normal",
      "one_persistent_matlab_session": true,
      "wall_watchdog_s": 1800
    },
    "groups": {
      "G": "load, update, compile, six valid complete-run scenarios, direct source integrity and connected mission-control-actuator-6DOF evidence",
      "A": "nominal path, altitude and speed attainment with bounded attitude and rate",
      "Q": "trajectory smoothness, finite states, actuator continuity and limited saturation",
      "M": "connected tiltrotor mechanisms plus causal response to mission, payload, wind and flight-mode changes",
      "R": "100 percent worst-case operability across all private scenarios",
      "D": "takeoff, disturbance recovery, forward-transition airspeed/tilt continuity and fixed-wing turn dynamics"
    },
    "weights": {
      "A": 0.2,
      "Q": 0.15,
      "M": 0.3,
      "R": 0.2,
      "D": 0.15
    },
    "aggregation": {
      "within_group": "weighted arithmetic mean of dedicated normalized indicators",
      "critical_multiscenario_performance": "minimum",
      "total": "G * 100 * A^0.20 * Q^0.15 * M^0.30 * R^0.20 * D^0.15"
    },
    "shortcut_minimum": [
      "missing or disconnected required output",
      "position command copied into the measured trajectory",
      "constant or duplicated actuator channels",
      "nominal output replayed for every private mission",
      "wind and payload inputs ignored",
      "missing connected mission, feedback, actuator, aerodynamic or 6DOF plant mechanism"
    ],
    "scoring_policy": {
      "policy_id": "simuverity-101-v1:xaero-04:scoring"
    }
  },
